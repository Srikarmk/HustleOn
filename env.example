# Gemini API key is NOT used by the app anymore — it lives as a Supabase
# Edge Function secret. Set it with:  supabase secrets set GEMINI_API_KEY=AIza...

# Supabase (optional overrides — defaults are baked into app.config.js)
# These are public client values; data is protected by Row-Level Security.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here

